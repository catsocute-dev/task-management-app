# PostgreSQL connection strings from Supabase
# Transaction pooler (port 6543) - used by Prisma Client at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require"

# Direct connection (port 5432) - used by Prisma CLI for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# JWT secret for token signing
JWT_SECRET="taskhub-assignment-2-secret-jwt-key-2026-very-secure"

# Real-time WebSocket Service (Pusher Channels - Free Tier)
# Sign up at https://pusher.com -> Create app (React / Node.js) -> App Keys
PUSHER_APP_ID="your_pusher_app_id"
PUSHER_KEY="your_pusher_key"
PUSHER_SECRET="your_pusher_secret"
PUSHER_CLUSTER="ap1"
NEXT_PUBLIC_PUSHER_KEY="your_pusher_key"
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"
