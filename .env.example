# PostgreSQL connection strings from Supabase
# Transaction pooler (port 6543) — used by Prisma Client at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require"

# Direct connection (port 5432) — used by Prisma CLI for migrations
# If IPv6 is unavailable, use the Session pooler URI on port 5432 instead
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
